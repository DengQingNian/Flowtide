{
  "name": "flowable-go-docs",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Flowable-go 重构进度文档站",
  "scripts": {
    "gen": "node scripts/gen-facts.mjs && node scripts/gen-content.mjs",
    "predev": "npm run gen",
    "dev": "vite --host 0.0.0.0",
    "prebuild": "npm run gen",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:links": "npm run gen",
    "check:facts": "node scripts/gen-facts.mjs && node scripts/verify-facts.mjs",
    "pretest": "npm run gen",
    "test:e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "@lucide/vue": "^1.63.0",
    "minisearch": "^7.1.1",
    "naive-ui": "^2.45.3",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.10.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.4.6",
    "gray-matter": "^4.0.3",
    "jsdom": "^26.0.0",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.2.0",
    "markdown-it-container": "^4.0.0",
    "playwright": "^1.64.1",
    "shiki": "^3.2.1",
    "typescript": "~5.9.3",
    "vite": "^7.1.0",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.3.13"
  }
}
