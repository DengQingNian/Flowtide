# MySQL 开发配置；复制为 .env 并填写本地凭据，禁止提交真实密码。
# 进程中同名环境变量优先于本文件，端口缺省为 3306。
db_mysql_host=127.0.0.1
db_mysql_port=3306
db_mysql_user=flowable
db_mysql_pwd='请填写开发库密码'
db_mysql_db_name=flowable_dev

# PostgreSQL 可使用下列独立字段，或通过 FLOWABLE_POSTGRES_DSN 注入完整连接串。
# TLS 模式由环境决定；本地无 TLS 验收库可显式设置 db_pg_sslmode=disable。
db_pg_host=127.0.0.1
db_pg_port=5432
db_pg_user=flowable
db_pg_pwd='请填写开发库密码'
db_pg_db=flowable_dev
db_pg_schema=public
